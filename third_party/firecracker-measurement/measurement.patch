@@ -0,0 +1,455 @@
+// Copyright 2026 Amazon.com, Inc. or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Opt-in correlated measurement emission. Emission is not collector persistence.
+use std::io::Write;
+
+use serde::{Deserialize, Serialize};
+
+use super::MetricsError;
+
+/// Bounded caller-selected request identity. Sequence starts at one.
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct MeasurementRequest {
+    /// Collector-selected process incarnation configured before measured work.
+    pub incarnation: String,
+    /// Strictly consecutive caller request sequence, independent of periodic writes.
+    pub request_sequence: u64,
+    /// Token correlated with the exact emitted frame.
+    pub request_id: String,
+}
+
+/// Header present in every opted-in metrics frame and successful API receipt.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct MeasurementReceipt {
+    /// Explicit additive wire schema.
+    pub schema: &'static str,
+    /// Configured process incarnation.
+    pub incarnation: String,
+    /// Sequence allocated before serialization, including failed attempts.
+    pub attempt_sequence: u64,
+    /// None for periodic and legacy FlushMetrics calls.
+    pub request_sequence: Option<u64>,
+    /// None for periodic and legacy FlushMetrics calls.
+    pub request_id: Option<String>,
+    /// Sticky across the incarnation: a prior attempt may have lost deltas.
+    pub loss_detected: bool,
+}
+
+/// Token syntax is deliberately bounded and unambiguous on the wire.
+pub fn valid_measurement_token(token: &str) -> bool {
+    !token.is_empty()
+        && token.len() <= 128
+        && token
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_'))
+}
+
+impl MeasurementRequest {
+    /// Reject malformed requests before any attempt or metric serialization.
+    pub fn validate(&self) -> Result<(), MetricsError> {
+        if !valid_measurement_token(&self.incarnation)
+            || !valid_measurement_token(&self.request_id)
+            || self.request_sequence == 0
+        {
+            return Err(MetricsError::Measurement(
+                "invalid measurement request".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct MeasurementState {
+    incarnation: String,
+    attempt_sequence: u64,
+    loss_detected: bool,
+    last_request: Option<(MeasurementRequest, Result<MeasurementReceipt, String>)>,
+}
+
+#[derive(Debug)]
+pub(super) struct MetricsSink<M> {
+    pub writer: M,
+    pub measurement: Option<MeasurementState>,
+}
+
+impl<M: Write> MetricsSink<M> {
+    pub fn new(writer: M, incarnation: Option<String>) -> Result<Self, MetricsError> {
+        if incarnation
+            .as_deref()
+            .is_some_and(|value| !valid_measurement_token(value))
+        {
+            return Err(MetricsError::Measurement(
+                "invalid measurement incarnation".into(),
+            ));
+        }
+        Ok(Self {
+            writer,
+            measurement: incarnation.map(|incarnation| MeasurementState {
+                incarnation,
+                attempt_sequence: 0,
+                loss_detected: false,
+                last_request: None,
+            }),
+        })
+    }
+
+    pub fn emit<T: Serialize>(
+        &mut self,
+        metrics: &T,
+        request: Option<&MeasurementRequest>,
+    ) -> Result<MeasurementReceipt, MetricsError> {
+        let state = self
+            .measurement
+            .as_mut()
+            .ok_or_else(|| MetricsError::Measurement("measurement mode not configured".into()))?;
+        if let Some(request) = request {
+            request.validate()?;
+            if request.incarnation != state.incarnation {
+                return Err(MetricsError::Measurement(
+                    "measurement incarnation mismatch".into(),
+                ));
+            }
+            if let Some((last, result)) = &state.last_request {
+                if request == last {
+                    return result.clone().map_err(MetricsError::Measurement);
+                }
+            }
+            let previous = state
+                .last_request
+                .as_ref()
+                .map_or(0, |(last, _)| last.request_sequence);
+            if previous.checked_add(1) != Some(request.request_sequence) {
+                return Err(MetricsError::Measurement(
+                    "measurement request conflict or reorder".into(),
+                ));
+            }
+        }
+        let result = (|| {
+            state.attempt_sequence = state
+                .attempt_sequence
+                .checked_add(1)
+                .ok_or_else(|| "measurement attempt sequence exhausted".to_string())?;
+            let receipt = MeasurementReceipt {
+                schema: "sig.fc-measurement.v1",
+                incarnation: state.incarnation.clone(),
+                attempt_sequence: state.attempt_sequence,
+                request_sequence: request.map(|r| r.request_sequence),
+                request_id: request.map(|r| r.request_id.clone()),
+                loss_detected: state.loss_detected,
+            };
+            #[derive(Serialize)]
+            struct Frame<'a, T> {
+                measurement: &'a MeasurementReceipt,
+                metrics: &'a T,
+            }
+            // Serialize exactly once. SharedIncMetric advances baselines during
+            // serialization; any error permanently disqualifies this window.
+            let mut bytes = serde_json::to_vec(&Frame {
+                measurement: &receipt,
+                metrics,
+            })
+            .map_err(|error| format!("measurement serialization failed: {error}"))?;
+            if bytes.len() > 1024 * 1024 {
+                return Err("measurement frame exceeds one MiB".into());
+            }
+            bytes.push(b'\n');
+            self.writer
+                .write_all(&bytes)
+                .map_err(|error| format!("measurement write failed: {error}"))?;
+            self.writer
+                .flush()
+                .map_err(|error| format!("measurement flush failed: {error}"))?;
+            Ok(receipt)
+        })();
+        if result.is_err() {
+            state.loss_detected = true;
+        }
+        if let Some(request) = request {
+            state.last_request = Some((request.clone(), result.clone()));
+        }
+        result.map_err(MetricsError::Measurement)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::logger::metrics::{IncMetric, Metrics, SharedIncMetric};
+    use serde::ser::SerializeStruct;
+    use std::io;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Debug, Default)]
+    struct SinkState {
+        bytes: Vec<u8>,
+        fail_after: Option<usize>,
+        fail_flush: bool,
+    }
+    #[derive(Clone, Debug, Default)]
+    struct TestWriter(Arc<Mutex<SinkState>>);
+    impl Write for TestWriter {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            let mut state = self.0.lock().unwrap();
+            let remaining = state
+                .fail_after
+                .map_or(bytes.len(), |limit| limit.saturating_sub(state.bytes.len()));
+            if remaining == 0 {
+                return Err(io::Error::other("injected partial write"));
+            }
+            let count = remaining.min(bytes.len());
+            state.bytes.extend_from_slice(&bytes[..count]);
+            Ok(count)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            if self.0.lock().unwrap().fail_flush {
+                Err(io::Error::other("injected flush"))
+            } else {
+                Ok(())
+            }
+        }
+    }
+    fn request(sequence: u64) -> MeasurementRequest {
+        MeasurementRequest {
+            incarnation: "epoch_1".into(),
+            request_sequence: sequence,
+            request_id: format!("flush_{sequence}"),
+        }
+    }
+    #[derive(Debug, Default, Serialize)]
+    struct Counters {
+        bytes: SharedIncMetric,
+    }
+
+    #[test]
+    fn measurement_periodic_interleaving_and_replay() {
+        let metrics = Metrics::new(Counters::default());
+        let writer = TestWriter::default();
+        metrics
+            .init_with_measurement(writer.clone(), Some("epoch_1".into()))
+            .unwrap();
+        metrics.bytes.add(11);
+        assert!(metrics.write().unwrap());
+        metrics.bytes.add(7);
+        let receipt = metrics.flush_measurement(&request(1)).unwrap();
+        assert_eq!(receipt.attempt_sequence, 2);
+        assert!(!receipt.loss_detected);
+        metrics.bytes.add(3);
+        metrics.write().unwrap();
+        let before = writer.0.lock().unwrap().bytes.clone();
+        assert_eq!(metrics.flush_measurement(&request(1)).unwrap(), receipt);
+        assert_eq!(writer.0.lock().unwrap().bytes, before);
+        let next = metrics.flush_measurement(&request(2)).unwrap();
+        assert_eq!(next.attempt_sequence, 4);
+        let bytes = writer.0.lock().unwrap().bytes.clone();
+        let frames: Vec<serde_json::Value> = bytes
+            .split(|b| *b == b'\n')
+            .filter(|line| !line.is_empty())
+            .map(|line| serde_json::from_slice(line).unwrap())
+            .collect();
+        assert_eq!(
+            frames
+                .iter()
+                .map(|frame| frame["metrics"]["bytes"].as_u64().unwrap())
+                .collect::<Vec<_>>(),
+            vec![11, 7, 3, 0]
+        );
+        assert!(metrics.flush_measurement(&request(1)).is_err());
+        let mut conflict = request(2);
+        conflict.request_id = "different".into();
+        assert!(metrics.flush_measurement(&conflict).is_err());
+        assert!(metrics.flush_measurement(&request(4)).is_err());
+        let mut wrong_epoch = request(3);
+        wrong_epoch.incarnation = "other".into();
+        assert!(metrics.flush_measurement(&wrong_epoch).is_err());
+        assert_eq!(writer.0.lock().unwrap().bytes, bytes);
+    }
+
+    #[test]
+    fn measurement_partial_write_and_flush_errors_are_sticky_and_replayed() {
+        for flush_error in [false, true] {
+            let metrics = Metrics::new(Counters::default());
+            let writer = TestWriter::default();
+            metrics
+                .init_with_measurement(writer.clone(), Some("epoch_1".into()))
+                .unwrap();
+            {
+                let mut state = writer.0.lock().unwrap();
+                state.fail_flush = flush_error;
+                if !flush_error {
+                    state.fail_after = Some(30);
+                }
+            }
+            metrics.bytes.add(19);
+            let first = metrics
+                .flush_measurement(&request(1))
+                .unwrap_err()
+                .to_string();
+            let before = writer.0.lock().unwrap().bytes.clone();
+            {
+                let mut state = writer.0.lock().unwrap();
+                state.fail_after = None;
+                state.fail_flush = false;
+            }
+            assert_eq!(
+                metrics
+                    .flush_measurement(&request(1))
+                    .unwrap_err()
+                    .to_string(),
+                first
+            );
+            assert_eq!(writer.0.lock().unwrap().bytes, before);
+            metrics.write().unwrap();
+            assert!(
+                metrics
+                    .flush_measurement(&request(2))
+                    .unwrap()
+                    .loss_detected
+            );
+        }
+    }
+
+    #[test]
+    fn measurement_concurrent_periodic_and_requested_are_serialized() {
+        let metrics = Arc::new(Metrics::new(Counters::default()));
+        let writer = TestWriter::default();
+        metrics
+            .init_with_measurement(writer.clone(), Some("epoch_1".into()))
+            .unwrap();
+        let barrier = Arc::new(std::sync::Barrier::new(2));
+        let periodic_metrics = metrics.clone();
+        let periodic_barrier = barrier.clone();
+        let periodic = std::thread::spawn(move || {
+            periodic_barrier.wait();
+            for _ in 0..100 {
+                periodic_metrics.bytes.add(1);
+                periodic_metrics.write().unwrap();
+            }
+        });
+        barrier.wait();
+        let mut receipts = Vec::new();
+        for sequence in 1..=100 {
+            metrics.bytes.add(1);
+            receipts.push(metrics.flush_measurement(&request(sequence)).unwrap());
+        }
+        periodic.join().unwrap();
+        let bytes = writer.0.lock().unwrap().bytes.clone();
+        let frames: Vec<serde_json::Value> = bytes
+            .split(|b| *b == b'\n')
+            .filter(|line| !line.is_empty())
+            .map(|line| serde_json::from_slice(line).unwrap())
+            .collect();
+        assert_eq!(frames.len(), 200);
+        assert_eq!(
+            frames
+                .iter()
+                .map(|frame| frame["metrics"]["bytes"].as_u64().unwrap())
+                .sum::<u64>(),
+            200
+        );
+        for (index, frame) in frames.iter().enumerate() {
+            assert_eq!(frame["measurement"]["attempt_sequence"], (index + 1) as u64);
+            assert_eq!(frame["measurement"]["loss_detected"], false);
+        }
+        for receipt in receipts {
+            assert_eq!(
+                frames[receipt.attempt_sequence as usize - 1]["measurement"],
+                serde_json::to_value(receipt).unwrap()
+            );
+        }
+    }
+
+    #[test]
+    fn measurement_oversized_frame_consumes_delta_and_sets_sticky_loss() {
+        #[derive(Serialize)]
+        struct LargeFrame {
+            consumed: SharedIncMetric,
+            padding: String,
+        }
+        let writer = TestWriter::default();
+        let mut sink = MetricsSink::new(writer.clone(), Some("epoch_1".into())).unwrap();
+        let large = LargeFrame {
+            consumed: SharedIncMetric::new(),
+            padding: "x".repeat(1024 * 1024),
+        };
+        large.consumed.add(23);
+        let error = sink
+            .emit(&large, Some(&request(1)))
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("exceeds one MiB"));
+        assert_eq!(large.consumed.fetch_diff(), 0);
+        assert!(writer.0.lock().unwrap().bytes.is_empty());
+        assert_eq!(
+            sink.emit(&Counters::default(), Some(&request(1)))
+                .unwrap_err()
+                .to_string(),
+            error
+        );
+        assert!(writer.0.lock().unwrap().bytes.is_empty());
+        let receipt = sink.emit(&Counters::default(), Some(&request(2))).unwrap();
+        assert_eq!(receipt.attempt_sequence, 2);
+        assert!(receipt.loss_detected);
+    }
+
+    #[derive(Debug)]
+    struct SerializationFailure {
+        consumed: SharedIncMetric,
+    }
+    impl Serialize for SerializationFailure {
+        fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+            let mut state = serializer.serialize_struct("Failure", 2)?;
+            state.serialize_field("consumed", &self.consumed)?;
+            Err(serde::ser::Error::custom(
+                "failure after delta serialization",
+            ))
+        }
+    }
+    #[test]
+    fn measurement_serialization_failure_poison_and_overflow() {
+        let mut sink = MetricsSink::new(TestWriter::default(), Some("epoch_1".into())).unwrap();
+        let metrics = SerializationFailure {
+            consumed: SharedIncMetric::new(),
+        };
+        metrics.consumed.add(13);
+        assert!(sink.emit(&metrics, None).is_err());
+        assert_eq!(metrics.consumed.fetch_diff(), 0);
+        assert!(
+            sink.emit(&Counters::default(), Some(&request(1)))
+                .unwrap()
+                .loss_detected
+        );
+        sink.measurement.as_mut().unwrap().attempt_sequence = u64::MAX;
+        assert!(sink.emit(&Counters::default(), Some(&request(2))).is_err());
+        assert!(sink.emit(&Counters::default(), None).is_err());
+        assert_eq!(
+            sink.measurement.as_ref().unwrap().attempt_sequence,
+            u64::MAX
+        );
+    }
+
+    #[test]
+    fn measurement_requires_initialized_opt_in_and_valid_identity() {
+        let metrics = Metrics::<Counters, TestWriter>::new(Counters::default());
+        assert!(metrics.flush_measurement(&request(1)).is_err());
+        assert!(!metrics.write().unwrap());
+        assert!(
+            metrics
+                .init_with_measurement(TestWriter::default(), Some("invalid/name".into()))
+                .is_err()
+        );
+        metrics.init(TestWriter::default()).unwrap();
+        assert!(metrics.flush_measurement(&request(1)).is_err());
+        let mut invalid = request(0);
+        assert!(invalid.validate().is_err());
+        invalid = request(1);
+        invalid.request_id = "x".repeat(129);
+        assert!(invalid.validate().is_err());
+        let mut sink = MetricsSink::new(TestWriter::default(), Some("epoch_1".into())).unwrap();
+        sink.measurement.as_mut().unwrap().last_request =
+            Some((request(u64::MAX), Err("old".into())));
+        assert!(sink.emit(&Counters::default(), Some(&request(1))).is_err());
+    }
+}
