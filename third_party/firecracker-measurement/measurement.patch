+#[cfg(test)]
+mod terminal_tests {
+    use super::*;
+
+    #[test]
+    fn terminal_dispatch_rejected_resume_does_not_release_event_manager() {
+        let (tx, rx) = channel();
+        tx.send(Box::new(VmmAction::Resume)).unwrap();
+        tx.send(Box::new(VmmAction::GetVmmVersion)).unwrap();
+        drop(tx);
+        let mut observed = Vec::new();
+        // Channel disconnect is the production fail-stop, not a normal loop exit.
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            dispatch_until_running(VmmAction::Pause, &rx, |request| {
+                observed.push(request);
+                true // terminal state survives every response, including rejected Resume
+            });
+        }));
+        assert!(result.is_err());
+        assert_eq!(
+            observed,
+            vec![
+                VmmAction::Pause,
+                VmmAction::Resume,
+                VmmAction::GetVmmVersion
+            ]
+        );
+    }
+
+    #[test]
+    fn terminal_dispatch_ordinary_successful_resume_returns() {
+        let (tx, rx) = channel();
+        tx.send(Box::new(VmmAction::Resume)).unwrap();
+        let mut count = 0;
+        dispatch_until_running(VmmAction::Pause, &rx, |request| {
+            count += 1;
+            request != VmmAction::Resume // successful ordinary resume changes authoritative state
+        });
+        assert_eq!(count, 2);
+    }
+}
