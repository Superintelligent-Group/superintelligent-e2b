+// This function is the actual adapter dispatch loop, also exercised without KVM.
+// The handler's authoritative state controls return to EventManager; no opcode does.
+fn dispatch_until_running(
+    first: VmmAction,
+    receiver: &Receiver<ApiRequest>,
+    mut handle: impl FnMut(VmmAction) -> bool,
+) {
+    let mut request = first;
+    while handle(request) {
+        request = *receiver.recv().expect("Error receiving API request.");
     }
