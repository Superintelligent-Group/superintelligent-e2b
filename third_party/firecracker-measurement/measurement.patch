+        assert_eq!(metrics.flush_measurement(&request(1)).unwrap(), receipt);
+        assert_eq!(writer.0.lock().unwrap().bytes, before);
+        let next = metrics.flush_measurement(&request(2)).unwrap();
+        assert_eq!(next.attempt_sequence, 4);
+        let bytes = writer.0.lock().unwrap().bytes.clone();
+        let frames: Vec<serde_json::Value> = bytes
+            .split(|b| *b == b'\n')
