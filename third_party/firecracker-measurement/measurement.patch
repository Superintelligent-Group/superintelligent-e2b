+// Copyright 2026 Amazon.com, Inc. or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Opt-in correlated measurement emission. Emission is not collector persistence.
+use std::io::Write;
+
+use serde::{Deserialize, Serialize};
+
+use super::MetricsError;
+
+/// Bounded caller-selected request identity. Sequence starts at one.
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct MeasurementRequest {
+    /// Collector-selected process incarnation configured before measured work.
+    pub incarnation: String,
+    /// Strictly consecutive caller request sequence, independent of periodic writes.
+    pub request_sequence: u64,
+    /// Token correlated with the exact emitted frame.
+    pub request_id: String,
+}
+
+/// Header present in every opted-in metrics frame and successful API receipt.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct MeasurementReceipt {
+    /// Explicit additive wire schema.
+    pub schema: &'static str,
+    /// Configured process incarnation.
+    pub incarnation: String,
+    /// Sequence allocated before serialization, including failed attempts.
+    pub attempt_sequence: u64,
+    /// None for periodic and legacy FlushMetrics calls.
+    pub request_sequence: Option<u64>,
+    /// None for periodic and legacy FlushMetrics calls.
+    pub request_id: Option<String>,
+    /// Sticky across the incarnation: a prior attempt may have lost deltas.
+    pub loss_detected: bool,
+}
+
+/// Irreversible runtime cutoff and its correlated emission; not durable custody.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct TerminalMeasurementReceipt {
+    /// Distinct terminal protocol schema.
+    pub schema: &'static str,
+    /// Counts end at the last completed device operation, without draining queues.
+    pub cutoff: &'static str,
+    /// Exact emitted metrics header.
+    pub measurement: MeasurementReceipt,
+}
+
+/// Token syntax is deliberately bounded and unambiguous on the wire.
+pub fn valid_measurement_token(token: &str) -> bool {
+    !token.is_empty()
+        && token.len() <= 128
+        && token
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_'))
+}
+
+impl MeasurementRequest {
+    /// Reject malformed requests before any attempt or metric serialization.
+    pub fn validate(&self) -> Result<(), MetricsError> {
+        if !valid_measurement_token(&self.incarnation)
+            || !valid_measurement_token(&self.request_id)
+            || self.request_sequence == 0
+        {
+            return Err(MetricsError::Measurement(
+                "invalid measurement request".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct MeasurementState {
+    incarnation: String,
+    attempt_sequence: u64,
+    loss_detected: bool,
+    last_request: Option<(MeasurementRequest, Result<MeasurementReceipt, String>)>,
+}
+
+#[derive(Debug)]
+pub(super) struct MetricsSink<M> {
+    pub writer: M,
+    pub measurement: Option<MeasurementState>,
+    terminal: Option<(
+        MeasurementRequest,
+        Result<TerminalMeasurementReceipt, String>,
+    )>,
+}
+
+impl<M: Write> MetricsSink<M> {
+    pub fn new(writer: M, incarnation: Option<String>) -> Result<Self, MetricsError> {
+        if incarnation
+            .as_deref()
+            .is_some_and(|value| !valid_measurement_token(value))
+        {
+            return Err(MetricsError::Measurement(
+                "invalid measurement incarnation".into(),
+            ));
+        }
+        Ok(Self {
+            terminal: None,
+            writer,
+            measurement: incarnation.map(|incarnation| MeasurementState {
+                incarnation,
+                attempt_sequence: 0,
+                loss_detected: false,
+                last_request: None,
+            }),
+        })
+    }
+
+    pub fn emit<T: Serialize>(
+        &mut self,
+        metrics: &T,
+        request: Option<&MeasurementRequest>,
+    ) -> Result<MeasurementReceipt, MetricsError> {
+        if self.terminal.is_some() {
+            return Err(MetricsError::Measurement(
+                "measurement stream is terminal".into(),
+            ));
+        }
+        self.emit_inner(metrics, request, false)
+    }
+
+    pub fn finalize<T: Serialize, F: FnOnce() -> Result<(), String>>(
+        &mut self,
+        metrics: &T,
+        request: &MeasurementRequest,
+        pause: F,
+    ) -> Result<TerminalMeasurementReceipt, MetricsError> {
+        if let Some((last, result)) = &self.terminal {
+            return if last == request {
+                result.clone().map_err(MetricsError::Measurement)
+            } else {
+                Err(MetricsError::Measurement(
+                    "terminal request conflict".into(),
+                ))
+            };
+        }
+        request.validate()?;
+        let state = self
+            .measurement
+            .as_ref()
+            .ok_or_else(|| MetricsError::Measurement("measurement mode not configured".into()))?;
+        let previous = state
+            .last_request
+            .as_ref()
+            .map_or(0, |(last, _)| last.request_sequence);
+        if request.incarnation != state.incarnation
+            || previous.checked_add(1) != Some(request.request_sequence)
+            || state.attempt_sequence == u64::MAX
+        {
+            return Err(MetricsError::Measurement(
+                "terminal request must be fresh and emit-capable".into(),
+            ));
+        }
+        // Reserve the terminal identity while holding the writer lock. A panic or
+        // failed pause can never make this stream available for fresh attempts.
+        self.terminal = Some((
+            request.clone(),
+            Err("terminal operation interrupted".into()),
+        ));
+        let result = pause().and_then(|()| {
+            self.emit_inner(metrics, Some(request), true)
+                .map(|measurement| TerminalMeasurementReceipt {
+                    schema: "sig.fc-terminal-measurement.v1",
+                    cutoff: "last_completed_device_operation",
+                    measurement,
+                })
+                .map_err(|error| error.to_string())
+        });
+        self.terminal = Some((request.clone(), result.clone()));
+        result.map_err(MetricsError::Measurement)
+    }
+
+    fn emit_inner<T: Serialize>(
+        &mut self,
+        metrics: &T,
+        request: Option<&MeasurementRequest>,
+        terminal: bool,
+    ) -> Result<MeasurementReceipt, MetricsError> {
+        let state = self
+            .measurement
+            .as_mut()
+            .ok_or_else(|| MetricsError::Measurement("measurement mode not configured".into()))?;
+        if let Some(request) = request {
+            request.validate()?;
+            if request.incarnation != state.incarnation {
+                return Err(MetricsError::Measurement(
+                    "measurement incarnation mismatch".into(),
+                ));
+            }
+            if let Some((last, result)) = &state.last_request {
+                if request == last {
+                    return result.clone().map_err(MetricsError::Measurement);
+                }
+            }
+            let previous = state
+                .last_request
+                .as_ref()
+                .map_or(0, |(last, _)| last.request_sequence);
+            if previous.checked_add(1) != Some(request.request_sequence) {
+                return Err(MetricsError::Measurement(
+                    "measurement request conflict or reorder".into(),
+                ));
+            }
+        }
+        let result = (|| {
+            state.attempt_sequence = state
+                .attempt_sequence
+                .checked_add(1)
+                .ok_or_else(|| "measurement attempt sequence exhausted".to_string())?;
+            let receipt = MeasurementReceipt {
+                schema: "sig.fc-measurement.v1",
+                incarnation: state.incarnation.clone(),
+                attempt_sequence: state.attempt_sequence,
+                request_sequence: request.map(|r| r.request_sequence),
+                request_id: request.map(|r| r.request_id.clone()),
+                loss_detected: state.loss_detected,
+            };
+            #[derive(Serialize)]
+            struct Frame<'a, T> {
+                measurement: &'a MeasurementReceipt,
+                metrics: &'a T,
+                #[serde(skip_serializing_if = "Option::is_none")]
+                terminal_cutoff: Option<&'static str>,
+            }
+            // Serialize exactly once. SharedIncMetric advances baselines during
+            // serialization; any error permanently disqualifies this window.
+            let mut bytes = serde_json::to_vec(&Frame {
+                measurement: &receipt,
+                metrics,
+                terminal_cutoff: terminal.then_some("last_completed_device_operation"),
+            })
+            .map_err(|error| format!("measurement serialization failed: {error}"))?;
+            if bytes.len() > 1024 * 1024 {
+                return Err("measurement frame exceeds one MiB".into());
+            }
+            bytes.push(b'\n');
+            self.writer
+                .write_all(&bytes)
+                .map_err(|error| format!("measurement write failed: {error}"))?;
+            self.writer
+                .flush()
+                .map_err(|error| format!("measurement flush failed: {error}"))?;
+            Ok(receipt)
+        })();
+        if result.is_err() {
+            state.loss_detected = true;
+        }
+        if let Some(request) = request {
+            state.last_request = Some((request.clone(), result.clone()));
+        }
+        result.map_err(MetricsError::Measurement)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::logger::metrics::{IncMetric, Metrics, SharedIncMetric};
+    use serde::ser::SerializeStruct;
+    use std::io;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Debug, Default)]
+    struct SinkState {
+        bytes: Vec<u8>,
+        fail_after: Option<usize>,
+        fail_flush: bool,
+    }
+    #[derive(Clone, Debug, Default)]
+    struct TestWriter(Arc<Mutex<SinkState>>);
+    impl Write for TestWriter {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            let mut state = self.0.lock().unwrap();
+            let remaining = state
+                .fail_after
+                .map_or(bytes.len(), |limit| limit.saturating_sub(state.bytes.len()));
+            if remaining == 0 {
+                return Err(io::Error::other("injected partial write"));
+            }
+            let count = remaining.min(bytes.len());
+            state.bytes.extend_from_slice(&bytes[..count]);
+            Ok(count)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            if self.0.lock().unwrap().fail_flush {
+                Err(io::Error::other("injected flush"))
+            } else {
+                Ok(())
+            }
+        }
+    }
+    fn request(sequence: u64) -> MeasurementRequest {
+        MeasurementRequest {
+            incarnation: "epoch_1".into(),
+            request_sequence: sequence,
+            request_id: format!("flush_{sequence}"),
+        }
+    }
+    #[derive(Debug, Default, Serialize)]
+    struct Counters {
+        bytes: SharedIncMetric,
+    }
+
+    #[test]
+    fn terminal_measurement_freshness_and_exact_replay() {
+        let metrics = Metrics::new(Counters::default());
+        let writer = TestWriter::default();
+        metrics
+            .init_with_measurement(writer.clone(), Some("epoch_1".into()))
+            .unwrap();
+        metrics.flush_measurement(&request(1)).unwrap();
+        for invalid in [
+            request(1),
+            request(3),
+            MeasurementRequest {
+                incarnation: "other".into(),
+                ..request(2)
+            },
+        ] {
+            assert!(
+                metrics
+                    .finalize_measurement(&invalid, || panic!("invalid request latched"))
+                    .is_err()
+            );
+        }
+        metrics.bytes.add(9);
+        let receipt = metrics
+            .finalize_measurement(&request(2), || Ok(()))
+            .unwrap();
+        assert_eq!(receipt.cutoff, "last_completed_device_operation");
+        assert_eq!(receipt.measurement.attempt_sequence, 2);
+        let before = writer.0.lock().unwrap().bytes.clone();
+        let frame: serde_json::Value =
+            serde_json::from_slice(before.split(|b| *b == b'\n').nth(1).unwrap()).unwrap();
+        assert_eq!(frame["terminal_cutoff"], receipt.cutoff);
+        assert_eq!(
+            frame["measurement"],
+            serde_json::to_value(&receipt.measurement).unwrap()
+        );
+        assert_eq!(frame["metrics"]["bytes"], 9);
+        assert_eq!(
+            metrics
+                .finalize_measurement(&request(2), || panic!("replay paused again"))
+                .unwrap(),
+            receipt
+        );
+        assert!(
+            metrics
+                .finalize_measurement(&request(3), || panic!("conflict paused"))
+                .is_err()
+        );
+        assert!(metrics.flush_measurement(&request(2)).is_err());
+        assert!(metrics.write().is_err()); // includes periodic and fatal-signal attempts
+        assert_eq!(writer.0.lock().unwrap().bytes, before);
+    }
+
+    #[test]
+    fn terminal_measurement_racing_periodic_writer_cannot_emit_after_cutoff() {
+        for _ in 0..20 {
+            let metrics = Arc::new(Metrics::new(Counters::default()));
+            let writer = TestWriter::default();
+            metrics
+                .init_with_measurement(writer.clone(), Some("epoch_1".into()))
+                .unwrap();
+            metrics.bytes.add(17);
+            let barrier = Arc::new(std::sync::Barrier::new(2));
+            let other_metrics = metrics.clone();
+            let other_barrier = barrier.clone();
+            let periodic = std::thread::spawn(move || {
+                other_barrier.wait();
+                other_metrics.write()
+            });
+            barrier.wait();
+            let receipt = metrics
+                .finalize_measurement(&request(1), || Ok(()))
+                .unwrap();
+            let periodic_ok = periodic.join().unwrap().is_ok();
+            let bytes = writer.0.lock().unwrap().bytes.clone();
+            let frames: Vec<serde_json::Value> = bytes
+                .split(|b| *b == b'\n')
+                .filter(|line| !line.is_empty())
+                .map(|line| serde_json::from_slice(line).unwrap())
+                .collect();
+            assert_eq!(frames.len(), if periodic_ok { 2 } else { 1 });
+            assert_eq!(
+                frames.last().unwrap()["measurement"],
+                serde_json::to_value(receipt.measurement).unwrap()
+            );
+            assert_eq!(
+                frames.last().unwrap()["terminal_cutoff"],
+                "last_completed_device_operation"
+            );
+            assert_eq!(
+                frames
+                    .iter()
+                    .map(|frame| frame["metrics"]["bytes"].as_u64().unwrap())
+                    .sum::<u64>(),
+                17
+            );
+            assert!(metrics.write().is_err());
+            assert_eq!(writer.0.lock().unwrap().bytes, bytes);
+        }
+    }
