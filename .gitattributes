*        text=auto
*.go     text      eol=lf
*.mod    text      eol=lf
*.sum    text      eol=lf linguist-generated=true
*.sh     text      eol=lf
*.tpl    text      eol=lf
*.conf   text      eol=lf
*.hcl    text      eol=lf
*.tf     text      eol=lf
*.py     text      eol=lf
*.service text     eol=lf
Makefile text      eol=lf
# A unified diff's blank context lines contain a required space. Its added-source
# whitespace is checked by git apply --whitespace=error-all in the pinned build.
third_party/firecracker-measurement/*.patch text eol=lf whitespace=-blank-at-eol
