# COST-00 P3 (SUP-619): repointed SIG (319933937176) -> CommonQuant (014155356804).
# SIG reference preserved in .env.dev.sig-backup.
# =============================================================================
# E2B Self-Hosted — Dev Environment
# =============================================================================
# Used by: make init / make plan / make apply
# See iac/provider-aws/Makefile for how these map to TF_VAR_*
# =============================================================================

# AWS
AWS_ACCOUNT_ID=014155356804
AWS_REGION=us-east-1
AWS_PROFILE=commonquant-boot

# Terraform
TERRAFORM_ENVIRONMENT=dev
TERRAFORM_STATE_BUCKET=commonquant-e2b-tfstate

# E2B Config
PROVIDER=aws
PREFIX=e2b-
BUCKET_PREFIX=e2b-014155356804-
DOMAIN_NAME=e2b.superintelligent.group

# Cluster sizing — all worker pools at 0 (auto-scaling handles spin-up/down)
CONTROL_SERVER_CLUSTER_SIZE=1
API_CLUSTER_SIZE=1
CLIENT_CLUSTER_SIZE=0
BUILD_CLUSTER_SIZE=0
CLICKHOUSE_CLUSTER_SIZE=0
INGRESS_COUNT=1
CLIENT_PROXY_COUNT=1

# Instance types
API_SERVER_MACHINE_TYPE=t3.large
CLIENT_SERVER_MACHINE_TYPE=c8i.2xlarge
BUILD_SERVER_MACHINE_TYPE=c8i.2xlarge
CONTROL_SERVER_MACHINE_TYPE=t3.medium

# Nested virtualization (required for Firecracker on virtual instances)
CLIENT_SERVER_NESTED_VIRTUALIZATION=true
BUILD_SERVER_NESTED_VIRTUALIZATION=true

# Redis (self-managed via Nomad, not AWS ElastiCache — cheaper for dev)
REDIS_MANAGED=false

# DB connection pool
DB_MAX_OPEN_CONNECTIONS=40
DB_MIN_IDLE_CONNECTIONS=5
AUTH_DB_MAX_OPEN_CONNECTIONS=20
AUTH_DB_MIN_IDLE_CONNECTIONS=5
